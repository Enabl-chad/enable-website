---
import Layout from '../layouts/Layout.astro';
import Card from '../components/Card.astro';
import Button from '../components/Button.astro';
import GradientText from '../components/GradientText.astro';

// Home page — real copy pulled from the Signal Dark design canvas
// (Main.dc.html artboard), Phase 2 of the build plan.
---

<Layout title="enabl — telecom engineering services">
	<!-- hero -->
	<section class="hero">
		<div class="hero__copy">
			<div class="eyebrow">
				<span class="eyebrow__dot eyebrow__dot--pink"></span>
				<span>Telecom Engineering Services</span>
			</div>
			<h1>Take your product from concept to deployment-ready.</h1>
			<p>
				Enabl covers mechanical design, RF design, supply chain, and solution scoping under one
				team — with the operational expertise to keep you ahead of problems instead of reacting
				to them.
			</p>
			<div class="hero__actions">
				<Button href="/contact">Start a conversation</Button>
				<a href="#enabling" class="text-link">See how we work →</a>
			</div>
		</div>
		<div class="hero__art" aria-hidden="true">
			<svg width="620" height="360" viewBox="0 0 620 360" class="hero__wave">
				<path
					d="M10,180 C60,180 90,60 140,60 C190,60 205,300 255,300 C305,300 320,110 375,110 C430,110 445,250 500,250 C540,250 560,180 610,180"
					stroke="url(#heroGrad)"
					stroke-width="5"
					stroke-linecap="round"
					fill="none"
				></path>
				<defs>
					<linearGradient id="heroGrad" x1="0" y1="0" x2="620" y2="0" gradientUnits="userSpaceOnUse">
						<stop offset="0%" stop-color="#FF2FD6"></stop>
						<stop offset="50%" stop-color="#9B3EE8"></stop>
						<stop offset="100%" stop-color="#2E7FFF"></stop>
					</linearGradient>
				</defs>
			</svg>
		</div>
	</section>

	<!-- enabling: pinned jump menu + scrolling beats -->
	<section id="enabling" class="enabling">
		<div class="section-heading">
			<h2>What enabling actually looks like</h2>
			<p>Four ways we carry a program from concept to running at scale. Click a step to jump to it.</p>
		</div>

		<div class="enabling__layout">
			<nav class="enabling__jump" aria-label="Jump to section">
				<svg width="180" height="106" viewBox="0 0 220 130" class="enabling__jump-wave" aria-hidden="true">
					<path
						d="M4,65 C24,65 34,20 54,20 C74,20 80,110 100,110 C120,110 126,38 150,38 C170,38 176,90 200,90 C208,90 214,65 216,65"
						stroke="url(#enablingGrad)"
						stroke-width="3.5"
						stroke-linecap="round"
						fill="none"
					></path>
					<defs>
						<linearGradient id="enablingGrad" x1="0" y1="0" x2="220" y2="0" gradientUnits="userSpaceOnUse">
							<stop offset="0%" stop-color="#FF2FD6"></stop>
							<stop offset="50%" stop-color="#9B3EE8"></stop>
							<stop offset="100%" stop-color="#2E7FFF"></stop>
						</linearGradient>
					</defs>
				</svg>
				<div class="enabling__jump-links">
					<a href="#enabling-technical"><span class="dot" style="background:#FF2FD6;"></span>Technical</a>
					<a href="#enabling-commercial"><span class="dot" style="background:#C15FE0;"></span>Commercial</a>
					<a href="#enabling-operational"><span class="dot" style="background:#9B3EE8;"></span>Operational</a>
					<a href="#enabling-you"><span class="dot" style="background:#2E7FFF;"></span>You</a>
				</div>
			</nav>

			<div class="enabling__beats">
				<div id="enabling-technical" class="beat beat--split">
					<div class="beat__copy">
						<h3><GradientText>Enabl</GradientText>ing Technical Success</h3>
						<p>
							We start by understanding the real goal, not just the spec sheet. Component and
							partner selection, design customization, simulation, and testing across mechanical
							and RF — every decision gets optimized against what the product actually has to do
							in the field.
						</p>
					</div>
					<div class="beat__illustrations">
						<div class="mini-card">
							<svg viewBox="0 0 140 140" width="100%" height="auto" aria-hidden="true">
								<polygon points="70,12 122,40 70,68 18,40" fill="#1C1926" stroke="#4E4A5C" stroke-width="1.3"></polygon>
								<polygon points="18,40 70,68 70,118 18,90" fill="#161320" stroke="#4E4A5C" stroke-width="1.3"></polygon>
								<polygon points="70,68 122,40 122,90 70,118" fill="#100E17" stroke="#4E4A5C" stroke-width="1.3"></polygon>
								<line x1="18" y1="128" x2="122" y2="128" stroke="#4E4A5C" stroke-width="1" stroke-dasharray="3,3"></line>
								<line x1="18" y1="122" x2="18" y2="134" stroke="#4E4A5C" stroke-width="1"></line>
								<line x1="122" y1="122" x2="122" y2="134" stroke="#4E4A5C" stroke-width="1"></line>
							</svg>
							<span>Mechanical / enclosure design</span>
						</div>
						<div class="mini-card">
							<svg viewBox="0 0 140 140" width="100%" height="auto" aria-hidden="true">
								<circle cx="70" cy="70" r="20" fill="none" stroke="#332E42" stroke-width="1" stroke-dasharray="2,3"></circle>
								<circle cx="70" cy="70" r="40" fill="none" stroke="#332E42" stroke-width="1" stroke-dasharray="2,3"></circle>
								<circle cx="70" cy="70" r="58" fill="none" stroke="#332E42" stroke-width="1" stroke-dasharray="2,3"></circle>
								<line x1="12" y1="70" x2="128" y2="70" stroke="#2A2635" stroke-width="1"></line>
								<line x1="70" y1="12" x2="70" y2="128" stroke="#2A2635" stroke-width="1"></line>
								<path d="M126,70 C126,50 108,32 82,30 C92,45 92,58 78,70 C92,82 92,95 82,110 C108,108 126,90 126,70 Z" fill="#FF2FD6" fill-opacity="0.12" stroke="#FF2FD6" stroke-width="1.4"></path>
								<path d="M55,70 C55,58 45,50 34,52 C40,60 40,80 34,88 C45,90 55,82 55,70 Z" fill="#FF2FD6" fill-opacity="0.12" stroke="#FF2FD6" stroke-width="1.4"></path>
							</svg>
							<span>RF / antenna simulation</span>
						</div>
					</div>
				</div>

				<div id="enabling-commercial" class="beat">
					<h3><GradientText>Enabl</GradientText>ing Commercial Success</h3>
					<p class="beat__lede">
						A design that works in the lab still has to work in the market. We engineer for cost,
						scale, and quality together, and balance international manufacturing partnerships
						against a shifting geopolitical world — so what you ship is something your business
						can actually sell.
					</p>
