				<h3>Full Solution Scoping</h3>
				<p>Turning a rough concept into a scoped, fundable program before a single part is ordered.</p>
			</Card>
		</div>
	</section>

	<!-- closing CTA -->
	<section class="closing-cta">
		<h2>Ready to move from concept to deployment-ready?</h2>
		<Button href="/contact">Start a conversation</Button>
	</section>

	<style>
		.eyebrow {
			display: flex;
			align-items: center;
			gap: 8px;
			font-size: 13px;
			letter-spacing: 0.08em;
			text-transform: uppercase;
			color: var(--color-muted);
		}
		.eyebrow__dot {
			width: 6px;
			height: 6px;
			border-radius: 50%;
			flex: none;
		}
		.eyebrow__dot--pink {
			background: var(--color-pink);
		}
		.dot {
			width: 8px;
			height: 8px;
			border-radius: 50%;
			flex: none;
			display: inline-block;
		}
		.text-link {
			font-size: 15px;
			color: var(--color-text);
			font-weight: 500;
			text-decoration: none;
		}
		.text-link:hover {
			color: var(--color-text-hi);
		}

		/* hero */
		.hero {
			display: flex;
