---
// Generic surface for services-grid items, principle cards, etc.
// Pass `as` to render something other than a plain <div> (e.g. "li").
interface Props {
	as?: string;
}
const { as: Tag = 'div' } = Astro.props;
---

<Tag class="card">
	<slot />
</Tag>

<style>
	.card {
		background: var(--color-surface);
		border: 1px solid var(--color-border);
		border-radius: var(--radius-card);
		padding: 24px;
	}
</style>
