---
// Wraps text in the brand pink→purple→blue gradient. Used for the
// "enabl" wordplay text — keep usage sparing, it's an accent, not a
// default text color.
---

<span class="gradient-text"><slot /></span>

<style>
	.gradient-text {
		background: var(--gradient-brand);
		-webkit-background-clip: text;
		background-clip: text;
		color: transparent;
	}
</style>
