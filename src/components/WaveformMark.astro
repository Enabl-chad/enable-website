---
// The Enabl wave mark — one reusable symbol instead of pasting the path
// per page. `variant="gradient"` for the nav, `variant="muted"` for the
// footer (see build plan, Section 2 / Phase 1).
interface Props {
	variant?: 'gradient' | 'muted';
	size?: number;
}
const { variant = 'gradient', size = 28 } = Astro.props;
---

<svg
	class="waveform-mark"
	width={size}
	height={size}
	viewBox="0 0 28 28"
	fill="none"
	xmlns="http://www.w3.org/2000/svg"
	aria-hidden="true"
>
	<path
		d="M2 14 C5 14, 6 7, 9 7 C12 7, 12.5 21, 15.5 21 C18.5 21, 19 10, 22 10 C24 10, 25 14, 26 14"
		stroke={variant === 'gradient' ? 'url(#waveform-gradient)' : '#716c80'}
		stroke-width="2"
		stroke-linecap="round"
	/>
	{
		variant === 'gradient' && (
			<defs>
				<linearGradient id="waveform-gradient" x1="2" y1="14" x2="26" y2="14" gradientUnits="userSpaceOnUse">
					<stop offset="0" stop-color="#ff2fd6" />
					<stop offset="0.5" stop-color="#9b3ee8" />
					<stop offset="1" stop-color="#2e7fff" />
				</linearGradient>
			</defs>
		)
	}
</svg>

<style>
	.waveform-mark {
		flex: none;
	}
</style>
